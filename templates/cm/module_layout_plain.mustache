{{!
    @template format_designer/cm/module_layout_plain

    Plain activity layout: reproduces Moodle's core course module markup
    (core_courseformat/local/content/cm) so an activity looks exactly like it does in the
    standard custom-sections format. All Designer chrome is intentionally omitted. The cm
    export produced by core lives under the cmformat key in the Designer cmitem context, so
    the core activity partial is rendered within that context.

    Example context (json):
    {
        "anchor": "module-3",
        "modclasses": "activity assign modtype_assign",
        "cm": { "id": 3 },
        "cmformat": { "hasname": true }
    }
}}
<li class="{{modclasses}} {{#cmformat.modstealth}}hiddenactivity{{/cmformat.modstealth}}"
    id="{{anchor}}"
    data-for="cmitem"
    data-id="{{cm.id}}">
    {{#editing}}
        {{< core_courseformat/local/content/divider}}
            {{$content}}
                {{#cmformat.activitychooserbutton}}
                    {{> core_courseformat/local/content/activitychooserbutton}}
                {{/cmformat.activitychooserbutton}}
            {{/content}}
        {{/ core_courseformat/local/content/divider}}
    {{/editing}}
    <div class="activity-item focus-control {{#cmformat.modstealth}}hiddenactivity{{/cmformat.modstealth}}{{!
            }}{{#cmformat.modhiddenfromstudents}}hiddenactivity{{/cmformat.modhiddenfromstudents}}{{!
            }}{{#cmformat.modinline}}activityinline{{/cmformat.modinline}}"
            data-activityname="{{cmformat.activityname}}" data-region="activity-card">
        {{#cmformat.cmbulk}}
            {{$ core_courseformat/local/content/cm/bulkselect }}
                {{> core_courseformat/local/content/cm/bulkselect }}
            {{/ core_courseformat/local/content/cm/bulkselect }}
        {{/cmformat.cmbulk}}
        {{#cmformat}}
            {{$ core_courseformat/local/content/cm/activity }}
                {{> core_courseformat/local/content/cm/activity }}
            {{/ core_courseformat/local/content/cm/activity }}
        {{/cmformat}}
    </div>
</li>

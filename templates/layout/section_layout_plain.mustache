{{!
    @template format_designer/layout/section_layout_plain

    Plain section layout: renders the activity list identically to Moodle's core
    custom-sections (topics) format by deferring to the core cmitem partial. This keeps the
    standard activity-item markup, icons and control-menu positioning, so a Designer course
    with no extra features looks and behaves like a standard course. Designer's cmitem export
    already provides the keys the core partial expects (id, anchor, module, extraclasses,
    cmformat, hasinfo, indent).

    Example context (json):
    {
        "cms": [],
        "showmovehere": false
    }
}}
{{#showmovehere}}
<p>{{movingstr}} (<a href="{{{cancelcopyurl}}}">{{#str}} cancel {{/str}}</a>)</p>
{{/showmovehere}}
{{!
    Note: intentionally NO "section" class here. Designer wraps sections in <ul class="designer">
    and styles ".designer .section ... li.activity ..." (e.g. absolutely positioning the activity
    action menu). Keeping the core "section" class would match those rules and break the plain
    (core custom-sections) appearance, so we use list-unstyled instead to keep core list styling.
}}
<ul class="m-0 p-0 img-text list-unstyled {{#hascms}} d-block {{/hascms}}" data-for="cmlist">
    {{#cms}}
        {{#showmovehere}}
        <li class="movehere">
            <a href="{{{moveurl}}}" title="{{strmovefull}}" class="movehere"></a>
        </li>
        {{/showmovehere}}
        {{#cmitem}}
            {{$ core_courseformat/local/content/section/cmitem}}
                {{> core_courseformat/local/content/section/cmitem}}
            {{/ core_courseformat/local/content/section/cmitem}}
        {{/cmitem}}
    {{/cms}}

    {{#showmovehere}}
    <li class="movehere">
        <a href="{{{movetosectionurl}}}" title="{{strmovefull}}" class="movehere"></a>
    </li>
    {{/showmovehere}}
</ul>
